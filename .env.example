# App
APP_NAME=ThesisAssistant
APP_ENV=development
API_V1_PREFIX=/api/v1
SECRET_KEY=replace-this-with-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Local persistence; relative paths are resolved against backend/
DATABASE_URL=sqlite:///./data/thesis_assistant.db
UPLOAD_DIR=./uploads
CHROMA_DIR=./chroma

# Ollama; no proprietary model APIs are used
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:3b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Upload and retrieval limits
MAX_UPLOAD_MB=25
CHUNK_SIZE_TOKENS=700
CHUNK_OVERLAP_TOKENS=100
RETRIEVAL_TOP_K=5
MIN_RELEVANCE_DISTANCE=0.75
OLLAMA_TIMEOUT_SECONDS=120
CORS_ORIGINS=http://localhost:3000

# Frontend configuration belongs in frontend/.env.local; see frontend/.env.example

# Extraction resource limits
MAX_PDF_PAGES=1000
MAX_EXTRACTED_CHARS=2000000
MAX_DOCX_EXPANDED_MB=100
MAX_CHUNKS=10000
