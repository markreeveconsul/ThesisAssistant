# Copy to frontend/.env.local. Leave Supabase values empty for local browser drafts.
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Production browser drafts are disabled unless explicitly enabled for a demo.
ALLOW_BROWSER_DRAFTS=false
# Server-only; not needed for current user-facing routes.
SUPABASE_SERVICE_ROLE_KEY=
# Used from Milestones 3/4 onward. Never prefix these with NEXT_PUBLIC_.
AI_CHAT_BASE_URL=https://openrouter.ai/api/v1
AI_CHAT_API_KEY=
AI_CHAT_MODEL=qwen/qwen3.5-35b-a3b
AI_EMBED_BASE_URL=https://openrouter.ai/api/v1
AI_EMBED_API_KEY=
AI_EMBED_MODEL=qwen/qwen3-embedding-8b
AI_EMBED_DIMENSIONS=1024
MAX_UPLOAD_MB=25
MAX_PDF_PAGES=300
